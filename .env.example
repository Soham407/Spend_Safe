# ============================================
# REQUIRED: Supabase Configuration
# ============================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_project_url

# Your Supabase anonymous/public key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# ============================================
# OPTIONAL: Application Configuration
# ============================================

# Application URL for metadata and redirects
# Production: https://yourdomain.com
# Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Server-only Environment Variables
# ============================================
# Add any server-only secrets below (not prefixed with NEXT_PUBLIC_)
# These will NOT be exposed to the browser
